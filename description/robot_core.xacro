<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:include filename="inertial_macros.xacro" />

    <xacro:property name="base_frame_length" value="0.8" />
    <xacro:property name="base_frame_width" value="0.5" />
    <xacro:property name="base_frame_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.15" />
    <xacro:property name="wheel_width" value="0.15" />
    <xacro:property name="wheel_effort_limit" value="200" />    
    <xacro:property name="wheel_velocity_limit" value="50.0" />    

    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="black">
        <color rgba="0 0 0 1"/>
    </material>

    <link name="base_link">
    </link>

    <!-- CHASSIS -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="-0.4 0 0"/>
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="${base_frame_length/2} 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="${base_frame_length} ${base_frame_width} ${base_frame_height}"/>
            </geometry>
            <material name="white"/>
        </visual>
        <collision>
            <origin xyz="${base_frame_length/2} 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="${base_frame_length} ${base_frame_width} ${base_frame_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="0.3" x="${base_frame_length}" y="${base_frame_width}" z="${base_frame_height}">
            <origin xyz="${base_frame_length/2} 0 0.1" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <!-- extra blok om voorkant aan te geven-->
    <joint name="chassis_voorkant_joint" type="fixed">
        <parent link="chassis"/>
        <child link="chassis_voorkant"/>
        <origin xyz="${base_frame_length-0.145} 0 0.2"/>
    </joint>
    <link name="chassis_voorkant">
        <visual>
            <origin xyz="0 0 0" rpy="0 ${pi/4} 0"/>
            <geometry>
                <box size="${base_frame_length/4} ${base_frame_width} ${base_frame_length/4}"/>
            </geometry>
            <material name="white"/>
        </visual>
        
    </link>
    <!-- LEFT WHEEL FRONT-->

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${base_frame_length/3} ${base_frame_width/2+wheel_width/2} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
    </joint>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="2" radius="${wheel_radius}" length="${wheel_width}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- RIGHT WHEEL FRONT-->

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${base_frame_length/3} -${base_frame_width/2+wheel_width/2} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>    
    </joint>

    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
            <material name="blue"/>
        </collision>
        <xacro:inertial_cylinder mass="2" radius="${wheel_radius}" length="${wheel_width}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>  
    </link>


    <!-- LEFT WHEEL BACK-->

    <joint name="left_wheel_back_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_back"/>
        <origin xyz="-${base_frame_length/3} ${base_frame_width/2+wheel_width/2} 0" rpy="-${pi/2} 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
    </joint>

    <link name="left_wheel_back">
        <visual>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="2" radius="${wheel_radius}" length="${wheel_width}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- RIGHT WHEEL BACK-->

    <joint name="right_wheel_back_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_back"/>
        <origin xyz="-${base_frame_length/3} -${base_frame_width/2+wheel_width/2} 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="${wheel_effort_limit}" velocity="${wheel_velocity_limit}"/>
    </joint>

    <link name="right_wheel_back">
        <visual>
            <geometry>
                <cylinder length="${wheel_width}" radius="${wheel_radius}" />
            </geometry>
            <material name="blue"/>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${wheel_radius}" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="2" radius="${wheel_radius}" length="${wheel_width}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>



</robot>