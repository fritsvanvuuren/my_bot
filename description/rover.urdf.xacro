<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="tutorial_rover">

  <xacro:property name="base_length" value="0.40" />
  <xacro:property name="base_width" value="0.30" />
  <xacro:property name="base_height" value="0.08" />
  <xacro:property name="wheel_radius" value="0.05" />
  <xacro:property name="wheel_width" value="0.04" />
  <xacro:property name="wheel_x" value="0.16" />
  <xacro:property name="wheel_y" value="0.12" />
  <xacro:property name="wheel_z" value="${wheel_radius}" />
  <xacro:property name="mast_height" value="0.18" />
  <xacro:property name="mast_width" value="0.06" />
  <xacro:property name="mast_depth" value="0.06" />
  <xacro:property name="camera_width" value="0.08" />
  <xacro:property name="camera_height" value="0.05" />
  <xacro:property name="camera_depth" value="0.05" />

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>
  </link>

  <xacro:macro name="wheel" params="name x y z">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 1.5708 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 1.5708 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}" />
        </geometry>
      </collision>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="base_link" />
      <child link="${name}" />
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel name="wheel_front_left" x="${wheel_x}" y="${wheel_y}" z="${wheel_z}" />
  <xacro:wheel name="wheel_front_right" x="${wheel_x}" y="-${wheel_y}" z="${wheel_z}" />
  <xacro:wheel name="wheel_rear_left" x="-${wheel_x}" y="${wheel_y}" z="${wheel_z}" />
  <xacro:wheel name="wheel_rear_right" x="-${wheel_x}" y="-${wheel_y}" z="${wheel_z}" />

  <link name="mast_link">
    <visual>
      <origin xyz="0 0 ${mast_height/2 + base_height}" rpy="0 0 0" />
      <geometry>
        <box size="${mast_width} ${mast_depth} ${mast_height}" />
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_height/2 + base_height}" rpy="0 0 0" />
      <geometry>
        <box size="${mast_width} ${mast_depth} ${mast_height}" />
      </geometry>
    </collision>
  </link>

  <joint name="mast_joint" type="fixed">
    <parent link="base_link" />
    <child link="mast_link" />
    <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 ${mast_height + base_height + camera_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${camera_width} ${camera_depth} ${camera_height}" />
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.9 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${mast_height + base_height + camera_height/2}" rpy="0 0 0" />
      <geometry>
        <box size="${camera_width} ${camera_depth} ${camera_height}" />
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="mast_link" />
    <child link="camera_link" />
    <origin xyz="0 0 ${mast_height/2}" rpy="0 0 0" />
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0.10 0 0.02" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.10" />
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.10 0 0.02" rpy="1.5708 0 0" />
      <geometry>
        <cylinder radius="0.015" length="0.10" />
      </geometry>
    </collision>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0.10 0 ${base_height}" rpy="0 0 0" />
  </joint>

</robot>
